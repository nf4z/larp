-- ======================================
-- FULL INVENTORY SCANNER
-- ======================================
local knownPets = {}
local inventoryScanCount = 0
local function inventoryPetId(pet, key)
    if type(pet) ~= "table" then return nil end
    return HatchWebhook.GetId(pet) or (type(key) == "string" and key) or nil
end

local initData = LocalData:Get()
if initData and initData.Pets then
    for key, pet in pairs(initData.Pets) do
        local id = inventoryPetId(pet, key)
        if id then knownPets[tostring(id)] = true end
    end
end

task.spawn(function()
    while true do
        task.wait(5)
        local data = LocalData:Get()
        if data and data.Pets then
            inventoryScanCount = inventoryScanCount + 1
            -- Drop IDs of pets no longer in inventory; prevents unbounded tracking.
            -- Refresh at most once per 5 minutes, not every 5-second poll.
            if inventoryScanCount % 60 == 0 then
                local currentIds = {}
                for key, storedPet in pairs(data.Pets) do
                    local storedId = inventoryPetId(storedPet, key)
                    if storedId then currentIds[tostring(storedId)] = true end
                end
                for oldId in pairs(knownPets) do
                    if not currentIds[oldId] then knownPets[oldId] = nil end
                end
            end
            for key, pet in pairs(data.Pets) do
                local id = inventoryPetId(pet, key)
                if not id or knownPets[tostring(id)] then continue end
                local name, info, rarity, isSuper, _, _, isXL = HatchWebhook.Describe(pet)
                if not isSuper and rarity ~= "Secret" and rarity ~= "Celestial"
                    and rarity ~= "Infinity" and rarity ~= "Void" then continue end
                knownPets[tostring(id)] = true
                local origin = getPetOrigin(info)
                if shouldSkipPet(origin, rarity) then continue end
                local shouldSendPrivate = not SKIP_PRIVATE_PETS[name]
                local threshold = getThreshold()
                local isInfinityOrVoid = rarity == "Infinity" or rarity == "Void"
                if threshold and not isSuper and not isXL and not isInfinityOrVoid
                    and not isOriginBypass(origin, rarity)
                    and getOneInX(info.Chance) <= threshold then
                    shouldSendPrivate = false
                end
                if not (shouldSendPrivate and HATCH_WEBHOOK_URL ~= "") and PUBLIC_WEBHOOK_URL == "" then
                    continue
                end
                local ok, payload, embed = pcall(HatchWebhook.Build, pet, {
                    info = info, hideUsername = hideUsername,
                    userId = shouldSendPrivate and DISCORD_USER_ID or "",
                    petId = id,
                })
                if not ok then
                    warn("[Webhook] Hatch formatting failed: " .. tostring(payload))
                    continue
                end
                if shouldSendPrivate and HATCH_WEBHOOK_URL ~= "" then
                    table.insert(hatchQueue, payload)
                    processHatch()
                end
                if PUBLIC_WEBHOOK_URL ~= "" then
                    -- Keep the existing public feed anonymous when it is configured.
                    embed.description = embed.description:gsub("^# %*%*.- hatched a ", "# **Player hatched a ", 1)
                    embed.fields[1].value = "Name : Hidden"
                    embed.footer.text = embed.footer.text:match("^(.-) | [^|]+$") or embed.footer.text
                    table.insert(publicQueue, HatchWebhook.Render({embeds = {embed}}))
                    processPublic()
                end
            end
        end
    end
end)

