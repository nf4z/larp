end

local function normalizePetName(name)
    name = tostring(name or ""):lower()
    name = name:gsub("^%s+", ""):gsub("%s+$", "")

    repeat
        local previous = name

        name = name:gsub("^shiny%s+", "")
            :gsub("^mythic%s+", "")
            :gsub("^xl%s+", "")
            :gsub("^super%s+", "")

        if name == previous then
            break
        end
    until false

    return (name:gsub("[%s_%-]+", ""))
end

