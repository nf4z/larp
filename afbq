-- ======================================
local function startEnchant()
    if enchantRunning then return end
    enchantRunning = true
    monitorRunning = true
    
    getgenv().ActivityStatus.current = "Auto Enchanting with " .. ENCHANT_DISPLAY[TARGET_ENCHANTS[1].Id] .. " + " .. ENCHANT_DISPLAY[TARGET_ENCHANTS[2].Id]
