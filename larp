				end
			end

			table.sort(candidates, function(leftPet, rightPet)
				local leftRank = altarPetRanks[leftPet.Name] or math.huge
				local rightRank = altarPetRanks[rightPet.Name] or math.huge
				if leftRank ~= rightRank then
					return leftRank < rightRank
				end
				return tostring(leftPet.Id) < tostring(rightPet.Id)
			end)

			if #candidates >= 3 then
				return {
					tostring(candidates[1].Id),
					tostring(candidates[2].Id),
					tostring(candidates[3].Id),
				}, false
			end
		end

		return nil
	end

