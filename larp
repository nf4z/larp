					and not activeStates.BGSI_Lite_IsPetEquipped(playerData, candidatePet.id)
					and remainingCopies - amountBeforeDelete >= minimumCopies
					and activeStates.BGSI_Lite_BlockedCleanupPets[candidatePet.id] == nil
