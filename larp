														if commandPetIdSet[inventoryPetId] then
															nextPetId = inventoryPetId
															break
														end
													end
													if not nextPetId then
														error("The selected pet stack changed before deletion finished")
													end

													local selectedPet, playerData = getCommandPet(nextPetId)
